{
  "manifest_version": 3,
  "name": "GitLab MR Previewer",
  "version": "1.0",
  "optional_host_permissions": ["https://*/*"],
  "content_scripts": [{
      "matches": ["https://chat.google.com/*"],
      "js": ["content.js"]
  }],
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["scripting", "storage"],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}